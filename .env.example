# ==============================================================================
# Coach Auto API — copy to .env and fill in. Never commit the real .env.
# ==============================================================================

ENVIRONMENT=development          # development | staging | production
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-characters

DATABASE_URL=postgresql://coachauto:changeme@localhost:5432/coachauto

# Comma-separated. Must match exactly where the frontend is served from.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Set COOKIE_SECURE=false only for local HTTP. Always true in production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Set when the API and frontend are on different subdomains of one domain,
# e.g. .autonomyfitness.press
# COOKIE_DOMAIN=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

SUPPORT_EMAIL=coachauto2026@gmail.com
INSTAGRAM_URL=https://www.instagram.com/coach.auto

# Optional. Without these, emails are written to the log instead of sent.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=coachauto2026@gmail.com
# SMTP_PASSWORD=your-app-specific-password
# SMTP_FROM=Coach Auto <coachauto2026@gmail.com>

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# One-time bootstrap. Turn off again once the coach account exists.
SEED_ON_STARTUP=false
COACH_EMAIL=coachauto2026@gmail.com
# COACH_PASSWORD=
